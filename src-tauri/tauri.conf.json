{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carmen",
  "version": "1.1.0",
  "identifier": "com.z44d.carmen",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Carmen",
        "width": 1320,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https:; media-src 'self' asset: http://asset.localhost blob: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https:; font-src 'self' data:; worker-src 'self' blob:; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Offline-first, cross-platform music player",
    "longDescription": "Carmen is a lightweight offline-first music player built with Tauri v2, React and TypeScript.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "android": {}
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["https"],
          "host": "carmen.z44d.com",
          "pathPrefix": ["/"],
          "appLink": true
        },
        {
          "scheme": ["carmen"],
          "appLink": false
        }
      ]
    }
  }
}
